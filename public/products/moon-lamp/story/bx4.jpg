<script type="application/ld+json" class="rank-math-schema-pro">{"@context":"https://schema.org","@graph":[{"@type":"Place","@id":"https://www.boxdeals.co.za/#place","address":{"@type":"PostalAddress"}},{"@type":["Store","Organization"],"@id":"https://www.boxdeals.co.za/#organization","name":"MnM Box Deals","url":"https://www.boxdeals.co.za","sameAs":["https://www.facebook.com/people/Box-Deals-SA","https://www.instagram.com/boxdealssa/https://www.tiktok.com/@boxdealssa"],"address":{"@type":"PostalAddress"},"logo":{"@type":"ImageObject","@id":"https://www.boxdeals.co.za/#logo","url":"https://www.boxdeals.co.za/wp-content/uploads/2024/03/MNM-Box-Deals-Logo-black.png","contentUrl":"https://www.boxdeals.co.za/wp-content/uploads/2024/03/MNM-Box-Deals-Logo-black.png","caption":"MnM Box Deals","inLanguage":"en-US","width":"504","height":"191"},"openingHours":["Mo,Tu,We,Th,Fr,Sa,Su 09:00-17:00"],"description":"Welcome to MnM Box Deals, where family values and a passion for quality products come together! Based in South Africa, our family-run business is deeply rooted in the spirit of the Rainbow Nation, which is why we proudly feature rainbow colors in our logo.\n\nEstablished in 2016, MnM started with humble beginnings\u2014selling just four items from our kitchen table. Today, we\u2019ve grown into a thriving warehouse operation located in the East Rand of Johannesburg, catering to both online retail and wholesale clients. Our pick-up point is conveniently situated in Nigel.\n\nAt MnM, our mission is simple: to provide our customers with exceptional service and a seamless shopping experience. We are committed to honesty and integrity, ensuring that we assist you every step of the way. If you have any inquiries, please don\u2019t hesitate to reach out at info@boxdeals.co.za.\n\nWe offer three convenient delivery options: collection from our warehouse, doorstep courier service, or delivery to a nearby Pudo locker, making it easier than ever to get your favorite products.\n\nOur vision was to supply South Africa with quality items at reasonable prices, and we\u2019ve built our success on solid family principles. As we continue to grow, we aim to empower stay-at-home parents and aspiring entrepreneurs through our wholesale online business. With over 100 agents nationwide, we are excited to extend our reach and support individuals as they create their own success and family legacies.\n\nOur friendly and dedicated team is always ready to assist you\u2014whether it\u2019s through a phone call, WhatsApp message, or email. Each order is packed with care and appreciation for our valued customers.\n\nIf you\u2019re interested in our wholesale offerings, please contact us at 011 814 3627/ 083 304 9612 or email wholesale@boxdeals.co.za for more information. Join us on this exciting journey, and let\u2019s create success together!","legalName":"lavalamplab","location":{"@id":"https://www.boxdeals.co.za/#place"},"image":{"@id":"https://www.boxdeals.co.za/#logo"}},{"@type":"WebSite","@id":"https://www.boxdeals.co.za/#website","url":"https://www.boxdeals.co.za","name":"MnM Box Deals","alternateName":"Box Deals","publisher":{"@id":"https://www.boxdeals.co.za/#organization"},"inLanguage":"en-US","potentialAction":{"@type":"SearchAction","target":"https://www.boxdeals.co.za/?s={search_term_string}","query-input":"required name=search_term_string"}},{"@type":"WebPage","@id":"https://www.boxdeals.co.za/#webpage","url":"https://www.boxdeals.co.za/","name":"MnM Box Deals | Quality &amp; Affordability, That&#039;s Our Priority","datePublished":"2020-07-26T02:07:49+02:00","dateModified":"2026-08-11T05:13:05+02:00","about":{"@id":"https://www.boxdeals.co.za/#organization"},"isPartOf":{"@id":"https://www.boxdeals.co.za/#website"},"inLanguage":"en-US"},{"@type":"Person","@id":"https://www.boxdeals.co.za/#author","name":"lavalamplab","image":{"@type":"ImageObject","@id":"https://secure.gravatar.com/avatar/db622ccbffdd40eda5e5a9c6d0f5644fda6850730d22a0e736b3ea9447f622fa?s=96&amp;d=mm&amp;r=g","url":"https://secure.gravatar.com/avatar/db622ccbffdd40eda5e5a9c6d0f5644fda6850730d22a0e736b3ea9447f622fa?s=96&amp;d=mm&amp;r=g","caption":"lavalamplab","inLanguage":"en-US"},"worksFor":{"@id":"https://www.boxdeals.co.za/#organization"}},{"@type":"Article","headline":"MnM Box Deals | Quality &amp; Affordability, That&#039;s Our Priority","keywords":"mnm box deals,affordable products,east rand shopping,nigel pickup point,online shopping","datePublished":"2020-07-26T02:07:49+02:00","dateModified":"2026-08-11T05:13:05+02:00","author":{"@id":"https://www.boxdeals.co.za/#author","name":"lavalamplab"},"publisher":{"@id":"https://www.boxdeals.co.za/#organization"},"description":"Shop quality, affordable products from MnM Box Deals, a family-run business where quality and affordability is our priority.","name":"MnM Box Deals | Quality &amp; Affordability, That&#039;s Our Priority","@id":"https://www.boxdeals.co.za/#richSnippet","isPartOf":{"@id":"https://www.boxdeals.co.za/#webpage"},"inLanguage":"en-US","mainEntityOfPage":{"@id":"https://www.boxdeals.co.za/#webpage"}}]}</script>
